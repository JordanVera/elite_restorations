# Public origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://eliterestorations.com

# Contact form delivery — configure SMTP (recommended) and/or a webhook.
# Until at least one is set, the form validates input but does not send anywhere.

# Gmail: use an App Password (see project README or contact form setup notes).
# SMTP_USER is the Gmail address messages are sent from.
# SMTP_PASS is the 16-character App Password, not your normal login password.
# SMTP_USER=you@yourcompany.com
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_NAME=Elite Restorations
# INQUIRY_EMAIL_TO=admin@eliterestorations.com

# Optional: POST each inquiry as JSON to this URL (Zapier, Make, custom API, etc.).
# INQUIRY_WEBHOOK_URL=

# Lead photos are stored in the public Vercel Blob store connected to this
# project. While these are unset, the photo picker reports that uploads are
# unavailable and the rest of the form still works.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Renovation Opportunity Finder — staff desk at /admin/renovation-opportunities
# Production database is Neon Postgres, provisioned with `vercel integration add neon`.
# DATABASE_URL=
# Prisma: npm run db:migrate
#
# Staff sign-in is Clerk (`vercel integration add clerk`), invite-only.
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
# Comma-separated staff emails. An empty list denies everyone.
# ADMIN_EMAILS=
# Localhost-only bypass while Clerk is pending. Ignored when NODE_ENV=production.
# OPPORTUNITY_DEV_AUTH=
#
# Private Blob store for concepts and imported photos. Do not reuse the public lead-photo token.
# Create it with `vercel blob create-store renovation-opportunities --access private`.
# OPPORTUNITY_BLOB_READ_WRITE_TOKEN=
#
# OpenAI. Vision analysis can use the Vercel AI Gateway (OIDC on Vercel).
# Image concepts call POST /v1/images/edits. Default model: gpt-image-2.5-sunburst.
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=openai/gpt-5.4
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
#
# HAR via Repliers. The key alone does not permit storage, AI, derivative images, or export.
# Set a flag to the word authorized only after written permission exists.
# REPLIERS_API_KEY=
# REPLIERS_STORAGE_AUTHORIZED=
# REPLIERS_AI_PROCESSING_AUTHORIZED=
# REPLIERS_DERIVATIVE_IMAGES_AUTHORIZED=
# REPLIERS_EXPORT_AUTHORIZED=
#
# Zillow is intentionally disabled. A pasted URL is a reference, not a fetch.
#
# Background runs use Vercel Workflow (`withWorkflow` in next.config.ts).
# Inspect local runs with `npx workflow inspect runs`.
# Do not launch a full paid generation during setup. Use the demo dataset first.
