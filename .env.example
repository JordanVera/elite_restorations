# Public origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://eliterestorations.com

# Contact form delivery.
# GoDaddy Node.js Hosting blocks outbound SMTP, so that host sends through the
# platform email gateway on 127.0.0.1:2525. Vercel and any other host do not
# have that gateway. Set SMTP_* or INQUIRY_WEBHOOK_URL there, or the estimate,
# emergency, and partner forms will tell the visitor to call or email instead.
# A webhook is optional in either environment. Messages still go to
# INQUIRY_EMAIL_TO (default admin@eliterestorations.com), with the same CC/BCC.

# Gmail: use an App Password (see project README or contact form setup notes).
# SMTP_USER is the mailbox messages are sent from.
# SMTP_PASS is the 16-character App Password, not your normal login password.
# SMTP_USER=you@yourcompany.com
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_NAME=Elite Restorations
# INQUIRY_EMAIL_TO=admin@eliterestorations.com
# INQUIRY_EMAIL_CC=george@eliterestorations.com
# INQUIRY_EMAIL_BCC=jordanvera@eliterestorations.com

# Optional: POST each inquiry as JSON to this URL (Zapier, Make, custom API, etc.).
# INQUIRY_WEBHOOK_URL=

# Lead photos are stored in the public Vercel Blob store connected to this
# project. While these are unset, the photo picker reports that uploads are
# unavailable and the rest of the form still works.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
