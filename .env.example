# Public origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://eliterestorations.com

# Contact form delivery.
# The site is hosted on Vercel. Vercel cannot use the old GoDaddy email
# gateway (127.0.0.1:2525). Without the SMTP variables below, the estimate,
# emergency, and partner forms tell the visitor to call instead.
#
# eliterestorations.com mail is Google Workspace:
#   MX    aspmx.l.google.com
#   SPF   v=spf1 include:_spf.google.com ~all
#   DMARC p=reject
# Send as a real mailbox on that domain through smtp.gmail.com. A From
# address on another domain, or a host that is not Google, is rejected and
# the lead does not arrive.
#
# SMTP_USER is the mailbox messages are sent from.
# SMTP_PASS is a Google App Password (16 characters), not the login password.
# SMTP_USER=admin@eliterestorations.com
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_NAME=Elite Restorations
#
# INQUIRY_EMAIL_TO defaults to admin@eliterestorations.com.
# CC and BCC are included only when set. Use real Google Workspace mailboxes.
# A mailbox that does not exist can cause Google to reject the whole message.
# INQUIRY_EMAIL_TO=admin@eliterestorations.com
# INQUIRY_EMAIL_CC=george@eliterestorations.com
# INQUIRY_EMAIL_BCC=
#
# Legacy GoDaddy Node.js hosting only. Do not set this on Vercel.
# EMAIL_GATEWAY=godaddy
#
# Optional extra copy (Zapier, Make, or another HTTPS endpoint).
# INQUIRY_WEBHOOK_URL=

# Lead photos use the public Blob store connected to this project.
# Create one under Storage → Blob if the project does not have it.
# Photo upload is skipped while the token is unset. The rest of the form works.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Jobber OAuth tokens use a separate PRIVATE Blob store. A private read or
# write against the public photo store is rejected. Connect that store with
# the environment variable prefix JOBBER_BLOB so Vercel sets
# JOBBER_BLOB_READ_WRITE_TOKEN (and may also set JOBBER_BLOB_STORE_ID).
# The app reads JOBBER_BLOB_READ_WRITE_TOKEN only. The token file is
# jobber/oauth.json. See docs/jobber.md.
# JOBBER_BLOB_READ_WRITE_TOKEN=
# JOBBER_BLOB_STORE_ID=

# Jobber. Estimate submissions also create a client and a request.
# A Jobber failure does not block the lead email. See docs/jobber.md.
# JOBBER_CLIENT_ID=35e3960e-113b-471a-a4e9-2d2e819153f9
# JOBBER_CLIENT_SECRET=
# JOBBER_CONNECT_KEY=
# JOBBER_GRAPHQL_VERSION=2025-04-16

# Inbound leads (Google Voice email and Local Services). See docs/leads-ingest.md.
# LEAD_INGEST_SECRET is the bearer token on POST /api/leads/inbound.
# Put the same value in each Apps Script project's Script Properties.
# LEAD_INGEST_SECRET=
#
# CRON_SECRET protects GET /api/cron/lsa-leads. Vercel sends it as
# Authorization: Bearer CRON_SECRET on the 30-minute cron. Use a different
# value from LEAD_INGEST_SECRET.
# CRON_SECRET=
#
# Google Ads OAuth for Local Services leads on customer 8441992586.
# The refresh token is stored in the private blob (google-ads/oauth.json),
# not in the environment. Do not put it in BLOB_READ_WRITE_TOKEN.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# Optional. When unset, the connect link accepts JOBBER_CONNECT_KEY.
# When both are set, either key works.
# GOOGLE_ADS_CONNECT_KEY=
# Optional. Developer tokens were sunset on 9 September 2026. The
# developer-token header is sent only when this is set. Leave it unset
# unless a call still requires it.
# GOOGLE_ADS_DEVELOPER_TOKEN=
