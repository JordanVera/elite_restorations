# Public origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://eliterestorations.com

# Contact form delivery.
# The site is hosted on Vercel. Vercel cannot use the old GoDaddy email
# gateway (127.0.0.1:2525). Without the SMTP variables below, the estimate,
# emergency, and partner forms tell the visitor to call instead.
#
# eliterestorations.com mail is Google Workspace:
#   MX    aspmx.l.google.com
#   SPF   v=spf1 include:_spf.google.com ~all
#   DMARC p=reject
# Send as a real mailbox on that domain through smtp.gmail.com. A From
# address on another domain, or a host that is not Google, is rejected and
# the lead does not arrive.
#
# SMTP_USER is the mailbox messages are sent from.
# SMTP_PASS is a Google App Password (16 characters), not the login password.
# SMTP_USER=admin@eliterestorations.com
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_NAME=Elite Restorations
#
# INQUIRY_EMAIL_TO defaults to admin@eliterestorations.com.
# CC and BCC are included only when set. Use real Google Workspace mailboxes.
# A mailbox that does not exist can cause Google to reject the whole message.
# INQUIRY_EMAIL_TO=admin@eliterestorations.com
# INQUIRY_EMAIL_CC=george@eliterestorations.com
# INQUIRY_EMAIL_BCC=
#
# Legacy GoDaddy Node.js hosting only. Do not set this on Vercel.
# EMAIL_GATEWAY=godaddy
#
# Optional extra copy (Zapier, Make, or another HTTPS endpoint).
# INQUIRY_WEBHOOK_URL=

# Lead photos and the Jobber token file use the Blob store connected to this
# project. Create one under Storage → Blob if the project does not have it.
# Photo upload is skipped while the token is unset. The rest of the form works.
# Jobber OAuth tokens are a private blob at jobber/oauth.json. See docs/jobber.md.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Jobber. Estimate submissions also create a client and a request.
# A Jobber failure does not block the lead email. See docs/jobber.md.
# JOBBER_CLIENT_ID=35e3960e-113b-471a-a4e9-2d2e819153f9
# JOBBER_CLIENT_SECRET=
# JOBBER_CONNECT_KEY=
# JOBBER_GRAPHQL_VERSION=2025-04-16
