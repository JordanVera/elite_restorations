# Public origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://eliterestorations.com

# Inquiry delivery is intentionally NOT configured. While this is unset the
# contact form validates input, reports that nothing was sent, and points the
# visitor to the phone number and email address instead.
# When set, each valid inquiry is POSTed as JSON to this URL.
# INQUIRY_WEBHOOK_URL=

# Lead photos are stored in a private Vercel Blob store and sent to the webhook
# as 14-day signed links. While no Blob credentials are set, the photo picker
# reports that uploads are unavailable and the rest of the form still works.
# Connect a Blob store to the project in Vercel to get BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=
